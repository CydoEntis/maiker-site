---
import "../styles/global.css";
import Header from "../sections/header/Header.astro";
import Footer from "../sections/footer/Footer.astro";
import { DOMAIN } from "../site";

const title = "Maiker · Run your coding agents side by side";
const description = "Maiker runs Claude Code, Codex and Gemini side by side, and tells you the moment one needs you. Free and open source for Windows, macOS and Linux.";
const url = `https://${DOMAIN}/`;
const card = `https://${DOMAIN}/img/og-card.png?v=3`;
---
<!doctype html>
<html lang="en" data-theme="night">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content="Maiker · Run them all. Know who needs you." />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Maiker. Run them all. Know who needs you." />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Maiker" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Maiker · Run your coding agents side by side" />
    <meta name="twitter:description" content="Run Claude Code, Codex and Gemini side by side, and know the moment one needs you." />
    <meta name="twitter:image" content={card} />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" href="/img/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/martian-mono-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline src="/boot.js"></script>
  </head>
  <body style="min-height:100vh;overflow-x:clip">
    <div id="live" aria-live="polite" class="sr-only"></div>
    <a class="fixed top-2 -left-[9999px] z-40 rounded-md bg-[var(--inv-bg)] px-3.5 py-2.5 font-mono text-sm font-semibold text-[var(--inv-fg)] focus:left-2" href="#top">Skip to content</a>
    <Header />
    <main id="top">
      <slot />
    </main>
    <Footer />
    <script>
      import "../lib/motion";
      import "../lib/live";
    </script>
  </body>
</html>
