---
import { DOMAIN, FACTORY, REPO } from "../../site";
---
<footer>
  <span class="brand"><img src="/img/maiker-logo.png" alt="" width="20" height="20" /><span class="word">M<span class="ai">ai</span>ker</span></span>
  <nav aria-label="Footer">
    <a href={REPO}>GitHub</a>
    <a href={`${REPO}/releases`}>Releases</a>
    <a href={`${REPO}/blob/main/LICENSE`}>MIT licence</a>
    <a href={FACTORY}>Maiker Factory</a>
  </nav>
  <span class="right"><span data-ver-footer hidden><span data-ver></span> · </span>{DOMAIN}</span>
</footer>

<style>
  footer { max-width: 1360px; margin: 0 auto; padding: 36px 24px 52px; display: flex; flex-wrap: wrap; gap: 20px; align-items: center; font-size: 14px; color: var(--dim); }
  .brand { display: flex; align-items: center; gap: 8px; color: var(--strong); }
  .word { font: 800 14px var(--font-display); }
  nav { display: flex; gap: 20px; flex-wrap: wrap; }
  nav a { text-decoration: none; }
  .right { margin-left: auto; font: 400 13px var(--font-mono); }
</style>

<script>
  import "./version";
</script>
