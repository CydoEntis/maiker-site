---
// The terminal app, recreated and interactive. The first frame is built here;
// hero.ts repaints it with the same renderer (tui-core.ts) after a click or key.
import { initialTui, renderTui } from "./tui-core";
const { sidebar, panes, bar } = renderTui(initialTui());
---
<div class="tui" data-tui tabindex="0" role="group" aria-label="The Maiker terminal app, interactive. Press Control and Space for key mode.">
  <div class="tui-main">
    <div class="tui-side" data-tui-side set:html={sidebar} />
    <div class="tui-grid" data-tui-panes set:html={panes} />
  </div>
  <div class="tui-bar" data-tui-bar set:html={bar} />
</div>

<style is:global>
  .tui { background: var(--t-bg); border: 1px solid var(--line2); border-radius: 0 12px 12px 12px; box-shadow: var(--shadow); font: 400 13px/1.5 var(--font-mono); color: var(--t-text); padding: 14px 12px 8px; display: flex; flex-direction: column; gap: 14px; min-height: 680px; box-sizing: border-box; outline-offset: 4px; text-align: left; }
  .tui-main { flex: 1; display: flex; flex-wrap: wrap; gap: 14px 10px; min-height: 0; }
  .tui-side { position: relative; flex: 0 1 34ch; min-width: min(100%, 30ch); border: 1px solid var(--t-line); border-radius: 8px; background: var(--t-card); padding: 16px 0 18px; }
  .tui-grid { flex: 1 1 520px; min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: 300px 300px; gap: 22px 10px; }
  .tui .chip { position: absolute; padding: 0 6px; line-height: 20px; white-space: nowrap; background: var(--t-sel); color: var(--t-text); }
  .tui .chip.b { font-weight: 700; color: var(--t-strong); }
  .tui .chip.d { color: var(--t-dim); }
  .tui .chip.bg { background: var(--t-bg); }
  .tui .chip.v { color: var(--t-violet); }
  .tui .chip.acc { background: var(--t-accent); color: var(--t-on); font-weight: 700; }
  .tui .tmh .chip, .tui .tui-bar .chip { position: static; line-height: inherit; }
  .tui .tm { margin: 2px 0 6px; }
  .tui .tmh { display: flex; align-items: center; gap: 6px; padding: 0 10px; margin-bottom: 4px; }
  .tui .tmh .chip.sel { color: var(--t-strong); font-weight: 700; }
  .tui .tr { display: block; width: 100%; padding: 3px 10px 3px 8px; border: 0; border-left: 2px solid transparent; background: transparent; color: inherit; font: inherit; text-align: left; }
  .tui .tr[data-on] { background: var(--t-sel); border-left-color: var(--t-accent); }
  .tui .tr1, .tui .tr2 { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tui .tr2 { padding-left: 2ch; }
  .tui .tr b { color: var(--t-strong); font-weight: 700; }
  .tui .tr b.idle { color: var(--t-dim); font-weight: 400; }
  .tui .tmk { color: var(--tc); }
  .tui [data-st="needs"] { --tc: var(--t-needs); } .tui [data-st="working"] { --tc: var(--t-work); } .tui [data-st="done"] { --tc: var(--t-done); } .tui [data-st="idle"] { --tc: var(--t-dim); }
  .tui .tdim { color: var(--t-dim); } .tui .tviolet { color: var(--t-violet); } .tui .tdone { color: var(--t-done); }
  .tui .tp { position: relative; min-width: 0; border: 1px solid var(--t-line); border-radius: 8px; padding: 16px 12px; opacity: .62; transition: opacity .2s, border-color .2s; }
  .tui .tp[data-on] { opacity: 1; }
  .tui .tp[data-i="0"] { grid-area: 1 / 1 / 2 / 2; } .tui .tp[data-i="1"] { grid-area: 2 / 1 / 3 / 2; } .tui .tp[data-i="2"] { grid-area: 1 / 2 / 3 / 3; }
  .tui .screen { position: absolute; inset: 16px 12px 14px; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; white-space: pre; font-size: 12.5px; line-height: 1.5; }
  .tui .ln { min-height: 1.5em; overflow: hidden; text-overflow: ellipsis; }
  .tui .ln.opt { cursor: pointer; }
  .tui-bar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; min-height: 22px; background: var(--t-card); margin: 0 -12px -8px; padding: 2px 12px; border-radius: 0 0 12px 12px; }
  .tui .keys { margin-left: auto; display: flex; gap: 14px; flex-wrap: wrap; }
  .tui .keys b { color: var(--t-accent); }
  .tui .tui-bar .chip { font-weight: 700; padding: 0 6px; }
  .tui[data-zoom] .tui-grid { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto; }
  .tui[data-zoom] .tp { grid-area: auto !important; min-height: 520px; }
  .tui[data-zoom] .tp:not([data-on]) { display: none; }
  @media (max-width: 560px) {
    .tui { min-height: auto; }
    .tui-grid { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto; }
    .tui .tp { grid-area: auto !important; min-height: 520px; }
    .tui .tp:not([data-on]) { display: none; }
  }
</style>
