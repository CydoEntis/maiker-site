---
import { RELEASES } from "../../site";
import Desktop from "./Desktop.astro";
import Tui from "./Tui.astro";
import { COMMANDS } from "../install/commands";
---
<section aria-labelledby="h-hero" class="sec hero">
  <div class="planes bg" aria-hidden="true"><div data-par class="par">
    <i style="background:var(--p1);clip-path:polygon(0 0,30% 0,50% 34%,30% 100%,0 100%)"></i>
    <i style="background:var(--p2);clip-path:polygon(30% 0,70% 0,50% 34%)"></i>
    <i style="background:var(--p3);clip-path:polygon(70% 0,100% 0,100% 100%,70% 100%,50% 34%)"></i>
  </div></div>
  <div class="in">
    <div class="center">
      <a data-rise class="pill" href={RELEASES}><span>Maitty is now <b>M<span class="ai">ai</span>ker</b></span><span class="chipv"><span data-ver>Latest release</span> →</span></a>
      <img data-rise class="logo" src="/img/maiker-logo.png" alt="" width="84" height="84" />
      <h1 data-rise id="h-hero"><span>Run them all.</span><span>Know who <span class="ai">needs you.</span></span></h1>
      <p data-rise class="sub">Claude Code, Codex and Gemini side by side, each in its own worktree. Maiker tells you the moment one stops to ask, and keeps them all running when you close the window.</p>
      <div data-rise class="actions">
        <a class="btn-inv dl" href={RELEASES}><span data-dl>Download for your computer</span><span aria-hidden="true">↓</span></a>
        <button type="button" class="cmd" data-copy aria-label="Copy the install command">
          <span class="dim" data-cmd-prompt>{COMMANDS.nix.prompt}</span><span class="short" data-cmd-short>{COMMANDS.nix.short}</span>
          <span class="copy" data-copy-label>Copy</span>
        </button>
      </div>
      <p data-rise class="fact">Free and open source · Windows, macOS, Linux · no account · installs as <span class="m">maitty</span></p>
    </div>

    <div data-rise class="demo" data-demo>
      <div data-tilt class="tilt">
        <div class="tabrow">
          <div role="tablist" aria-label="Which app to try">
            <button type="button" role="tab" id="tab-gui" aria-selected="true" aria-controls="panel-gui" data-tab="gui">Desktop app</button>
            <button type="button" role="tab" id="tab-tui" aria-selected="false" aria-controls="panel-tui" data-tab="tui">Terminal app</button>
          </div>
          <p class="hint" data-hint-gui>The desktop app, live. Open a chat, answer a card.</p>
          <p class="hint" data-hint-tui hidden>Click a pane. Press 1 to answer the one that needs you. Ctrl+Space for key mode.</p>
        </div>
        <div id="panel-gui" role="tabpanel" aria-labelledby="tab-gui" data-panel="gui">
          <div class="guiframe phone:hidden"><Desktop /></div>
          <div class="phonecard hidden phone:flex">
            <img src="/img/maiker-logo.png" alt="" width="56" height="56" />
            <p>The desktop app is built for a bigger screen. Open the live demo full size.</p>
            <a href="/demo/" target="_blank" rel="noopener">Open the desktop demo</a>
          </div>
        </div>
        <div id="panel-tui" role="tabpanel" aria-labelledby="tab-tui" data-panel="tui" hidden><Tui /></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow-x: clip; }
  .bg { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .par { position: absolute; inset: -10% 0; will-change: transform; }
  .in { position: relative; max-width: 1360px; margin: 0 auto; padding: clamp(44px, 7vw, 88px) 24px clamp(56px, 7vw, 96px); }
  .center { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .pill { display: inline-flex; align-items: center; gap: 10px; height: 32px; padding: 0 6px 0 14px; border: 1px solid var(--line2); background: var(--card); border-radius: 999px; font-size: 13px; color: var(--muted); text-decoration: none; }
  .pill b { color: var(--strong); font-weight: 600; }
  .chipv { height: 22px; padding: 0 10px; display: inline-flex; align-items: center; border-radius: 999px; background: var(--raised); color: var(--strong); font: 600 12px var(--font-mono); }
  .logo { display: block; margin-top: 36px; filter: drop-shadow(0 18px 30px rgba(0,0,0,.45)); }
  h1 { margin-top: 28px; font: 800 clamp(38px, 6.4vw, 96px)/.98 var(--font-display); letter-spacing: -.05em; color: var(--strong); }
  h1 > span { display: block; }
  .sub { margin-top: 26px; max-width: 54ch; font-size: clamp(17px, 1.5vw, 20px); line-height: 1.5; color: var(--text); text-wrap: pretty; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 30px; max-width: 100%; }
  .dl { height: 50px; padding: 0 22px; border-radius: 9px; font-size: 15px; }
  .cmd { display: flex; align-items: center; gap: 12px; height: 50px; padding: 0 8px 0 16px; max-width: 100%; border: 1px solid var(--line2); background: var(--card); border-radius: 9px; color: var(--strong); font: 400 13px var(--font-mono); min-width: 0; }
  .dim { color: var(--dim); }
  .short { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .copy { flex: none; height: 34px; padding: 0 12px; display: inline-flex; align-items: center; border-radius: 6px; background: var(--raised); color: var(--strong); font-weight: 600; }
  .fact { margin-top: 14px; font: 400 12px var(--font-mono); color: var(--dim); }
  .fact .m { color: var(--muted); }
  .demo { margin-top: clamp(48px, 6vw, 80px); perspective: 1800px; }
  .tilt { transform-origin: 50% 0; will-change: transform; }
  .tabrow { display: flex; align-items: flex-end; gap: 16px; flex-wrap: wrap; padding: 0 6px; }
  [role="tablist"] { display: flex; gap: 4px; }
  [role="tab"] { height: 40px; padding: 0 18px; border: 1px solid transparent; border-bottom: 0; border-radius: 10px 10px 0 0; background: transparent; color: var(--muted); font: 600 13px var(--font-mono); margin-bottom: -1px; position: relative; z-index: 2; }
  [role="tab"][aria-selected="true"] { border-color: var(--line2); }
  #tab-gui[aria-selected="true"] { background: #0f1013; color: #f4f4f5; }
  #tab-tui[aria-selected="true"] { background: var(--t-bg); color: var(--t-strong); }
  .hint { margin: 0 0 10px auto; font: 400 12px var(--font-mono); color: var(--dim); }
  .guiframe { border: 1px solid var(--line2); border-radius: 0 12px 12px 12px; overflow: hidden; background: #0f1013; box-shadow: var(--shadow); }
  .phonecard { flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding: 32px 24px; text-align: center; color: #cdcdd2; background: #0f1013; border: 1px solid var(--line2); border-radius: 0 12px 12px 12px; box-shadow: var(--shadow); }
  .phonecard p { max-width: 30ch; font-size: 15px; }
  .phonecard a { display: inline-flex; align-items: center; height: 44px; padding: 0 18px; border-radius: 8px; background: #f4f4f5; color: #0f1013; font: 600 14px var(--font-sans); text-decoration: none; }
  @media (max-width: 560px) { .hint { margin-left: 0; } }
</style>

<script>
  import "./hero";
</script>
