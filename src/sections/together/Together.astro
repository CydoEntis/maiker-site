---
const steps: [string, string][] = [["spec", "spec-writer"], ["build", "builder"], ["review", "reviewer"], ["ship", ""]];
---
<section aria-labelledby="h-together" class="sec">
  <div class="wrap cols">
    <div>
      <p data-rv class="eyebrow">Agents that work together</p>
      <h2 data-rv id="h-together" class="h2">Let them run each other.</h2>
      <p data-rv class="lede" style="max-width:50ch">Through the MCP server, <code>maitty mcp</code>, an agent can list, read, message, wait on and start other sessions, within limits you set. Helpers show under their session with their own steps, and any workflow reports where it is with one command.</p>
    </div>
    <pre data-rv tabindex="0" aria-label="A workflow report and its steps" data-run><span class="dim">$</span> maitty send --wait -p 3 "run the tests"
<span class="dim">$</span> maitty handoff 3 --to codex
<span class="dim">$</span> maitty workflow report &lt; run.json

<span class="strong">run job-42</span>
{steps.map(([name, helper], i) => (<span class="step" data-step={i} data-state={i === 0 ? "done" : i === 1 ? "working" : "wait"}>{"  "}<span class="g" data-glyph>{i === 0 ? "✓" : i === 1 ? "⠋" : "·"}</span>{" " + name.padEnd(8, " ")}<span class="dim">{helper}</span>{"\n"}</span>))}</pre>
  </div>
</section>

<style>
  code { font: 400 16px var(--font-mono); color: var(--strong); }
  pre { background: var(--well); border: 1px solid var(--line); border-radius: 14px; padding: 22px; font: 400 13px/1.85 var(--font-mono); color: var(--text); overflow: auto; white-space: pre; box-shadow: var(--shadow); }
  .dim { color: var(--dim); } .strong { color: var(--strong); }
  .g { color: var(--c); }
  .step[data-state="wait"] { --c: var(--dim); }
</style>

<script>
  import "./together";
</script>
