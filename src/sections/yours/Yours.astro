---
import { GLYPH, SESSIONS, sorted } from "../../lib/sessions";
import { THEMES } from "./themes";
const t = THEMES[0];
const rows = sorted(SESSIONS);
const vars = `--pv-bg:${t.bg};--pv-text:${t.text};--pv-dim:${t.dim};--pv-line:${t.line};--pv-accent:${t.accent};--needs:${t.needs};--working:${t.work};--done:${t.done};--dim:${t.dim}`;
---
<section aria-labelledby="h-yours" class="sec">
  <div class="wrap cols">
    <div>
      <p data-rv class="eyebrow">Make it yours</p>
      <h2 data-rv id="h-yours" class="h2">50 themes. Your keys.</h2>
      <p data-rv class="lede" style="max-width:48ch">25 dark, 25 light, every one contrast-checked and every colour yours to change. Floating or tiled panes, splits you drag, keys you rebind.</p>
      <div data-rv role="radiogroup" aria-label="Preview a theme" class="picks">
        {THEMES.map((th, i) => (
          <button type="button" role="radio" aria-checked={i === 0} data-theme-card
            data-name={th.name} data-bg={th.bg} data-text={th.text} data-dim={th.dim} data-line={th.line} data-accent={th.accent} data-needs={th.needs} data-work={th.work} data-done={th.done}>
            <span class="sw" style={`background:${th.bg}`}></span>{th.name}
          </button>
        ))}
      </div>
    </div>
    <div data-rv aria-hidden="true" class="pv" data-preview style={vars}>
      <div class="ph"><span class="chip" data-pv-chip>maitty</span><span class="dimt" data-pv-name>{t.name}</span></div>
      <div data-sorted data-limit="4">
        {rows.map((s) => <div class="r" data-sess={s.id} data-state={s.state}><span class="g" data-glyph>{GLYPH[s.state]}</span> <b>{s.name}</b> <span class="dimt">{s.project}</span></div>)}
      </div>
      <div class="keys"><span class="kc">Ctrl+Space</span>then<span class="kc">s</span>split right</div>
    </div>
  </div>
</section>

<style>
  .picks { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 26px; }
  .picks button { display: flex; align-items: center; gap: 8px; height: 38px; padding: 0 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--card); color: var(--text); font: 400 13px var(--font-mono); }
  .picks button[aria-checked="true"] { border-color: var(--strong); }
  .sw { width: 14px; height: 14px; border-radius: 3px; box-shadow: inset 0 0 0 1px rgba(127,127,127,.45); }
  .pv { background: var(--pv-bg); border: 1px solid var(--pv-line); border-radius: 14px; padding: 18px; font: 400 13px/1.8 var(--font-mono); color: var(--pv-text); transition: background .4s, color .4s, border-color .4s; box-shadow: var(--shadow); }
  .ph { display: flex; gap: 8px; margin-bottom: 12px; }
  .chip { padding: 0 8px; background: var(--pv-accent); color: var(--pv-bg); border-radius: 3px; font-weight: 600; transition: background .4s, color .4s; }
  .dimt { color: var(--pv-dim); }
  .r[hidden] { display: none; }
  .g { color: var(--c); }
  .keys { margin-top: 14px; display: flex; gap: 6px; flex-wrap: wrap; color: var(--pv-dim); }
  .kc { padding: 0 6px; border: 1px solid var(--pv-line); border-radius: 3px; color: var(--pv-text); }
</style>

<script>
  import "./yours";
</script>
