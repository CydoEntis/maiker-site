---
import { GLYPH, SESSIONS, sorted, WORD } from "../../lib/sessions";
const rows = sorted(SESSIONS);
---
<section aria-labelledby="h-close" class="sec" style="background:var(--p1)">
  <div class="wrap cols">
    <div>
      <p data-rv class="eyebrow">Close it, come back</p>
      <h2 data-rv id="h-close" class="h2">Go on. Close the window.</h2>
      <p data-rv class="lede" style="max-width:48ch">A background service owns every session, so the window is only a view. Close it, and they keep working. Crash or reboot, and they come back in the right folders with their conversations resumed.</p>
      <p data-rv class="note">These are the same agents as up top, still running.</p>
    </div>
    <div data-rv class="demo" data-close-demo>
      <div aria-hidden="true" class="planes">
        <i style="background:var(--p2);clip-path:polygon(0 0,40% 0,60% 55%,40% 100%,0 100%)"></i>
        <i style="background:var(--p3);clip-path:polygon(60% 0,100% 0,100% 100%,60% 55%)"></i>
      </div>
      <div class="win" data-win>
        <div class="wt">
          <img src="/img/maiker-logo.png" alt="" width="14" height="14" />
          <span class="wm">M<span class="ai">ai</span>ker</span>
          <button type="button" class="x" data-close aria-label="Close the window">×</button>
        </div>
        <div class="wb" data-sorted data-limit="7">
          {rows.map((s) => (
            <div class="r" data-sess={s.id} data-state={s.state}>
              <span class="g" data-glyph>{GLYPH[s.state]}</span><b>{s.name}</b><span class="pj">{s.project}</span><span class="w" data-word>{WORD[s.state]}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="tray" data-tray hidden>
        <div class="cmdl">$ <span>maitty ls</span></div>
        <div data-sorted data-limit="5">
          {rows.map((s) => (
            <div class="tr" data-sess={s.id} data-state={s.state}><span class="g" data-glyph>{GLYPH[s.state]}</span><span class="n">{s.name}</span><span class="w" data-word>{WORD[s.state]}</span></div>
          ))}
        </div>
        <button type="button" class="open" data-open>Open Maiker</button>
      </div>
      <div class="task">
        <button type="button" class="ico" data-open aria-label="Open Maiker"><img src="/img/maiker-logo.png" alt="" width="16" height="16" /></button>
        <span data-hm></span>
      </div>
    </div>
  </div>
</section>

<style>
  .note { margin-top: 14px; max-width: 48ch; font: 400 14px var(--font-mono); color: var(--dim); }
  .demo { position: relative; height: 440px; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); background: var(--bg); }
  .planes { position: absolute; inset: 0; }
  .win { position: absolute; left: 24px; right: 24px; top: 24px; bottom: 64px; background: var(--card); border: 1px solid var(--line2); border-radius: 10px; box-shadow: var(--shadow); overflow: hidden; transform-origin: calc(100% - 40px) calc(100% + 40px); transition: transform .55s cubic-bezier(.6,0,.2,1), opacity .45s; }
  .demo[data-closed] .win { transform: scale(.06); opacity: 0; pointer-events: none; }
  .wt { height: 34px; display: flex; align-items: center; gap: 8px; padding: 0 6px 0 12px; background: var(--bg); border-bottom: 1px solid var(--line); }
  .wm { font: 600 12px var(--font-sans); color: var(--strong); }
  .x { margin-left: auto; width: 30px; height: 26px; border: 0; border-radius: 4px; background: transparent; color: var(--muted); font: 400 16px var(--font-mono); }
  .x:hover { background: var(--raised); }
  .wb { padding: 8px; }
  .r { display: flex; align-items: center; gap: 10px; padding: 7px 10px; border-radius: 6px; font-size: 13px; }
  .r[hidden], .tr[hidden] { display: none; }
  .g { width: 14px; font: 600 12px var(--font-mono); color: var(--c); }
  .r b { font-weight: 600; color: var(--strong); }
  .pj { color: var(--dim); }
  .w { margin-left: auto; font: 400 12px var(--font-mono); color: var(--c); }
  .tray { position: absolute; left: 24px; bottom: 56px; width: 300px; max-width: calc(100% - 32px); background: var(--card); border: 1px solid var(--line2); border-radius: 10px; box-shadow: var(--shadow); padding: 8px; }
  .cmdl { padding: 4px 8px 6px; font: 400 12px var(--font-mono); color: var(--dim); }
  .cmdl span { color: var(--strong); }
  .tr { display: flex; gap: 8px; padding: 5px 8px; font-size: 13px; }
  .tr .n { color: var(--strong); }
  .open { width: 100%; margin-top: 6px; height: 34px; border: 0; border-radius: 6px; background: var(--inv-bg); color: var(--inv-fg); font: 600 13px var(--font-sans); }
  .task { position: absolute; left: 0; right: 0; bottom: 0; height: 40px; display: flex; align-items: center; justify-content: flex-end; gap: 12px; padding: 0 16px; background: var(--card); border-top: 1px solid var(--line); font: 400 12px var(--font-mono); color: var(--dim); }
  .ico { width: 28px; height: 28px; border: 0; border-radius: 6px; background: var(--raised); display: grid; place-items: center; }
</style>

<script>
  import "./close";
</script>
