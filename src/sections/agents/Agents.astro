---
const agents = ["Claude Code", "Codex", "Gemini"];
---
<section id="agents" aria-labelledby="h-agents" class="sec" style="background:var(--p1)">
  <div class="wrap">
    <h2 data-rv id="h-agents" class="eyebrow" style="margin-bottom:32px">Works with the agents you already use</h2>
    <ul data-rv data-agents>
      {agents.map((a, i) => <li data-on={i === 0 ? "" : undefined}>{a}</li>)}
    </ul>
    <p data-rv class="note">Any other command-line agent runs in a terminal pane beside them.</p>
  </div>
</section>

<style>
  ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 26px; font: 800 clamp(26px, 4.2vw, 58px)/1.2 var(--font-display); letter-spacing: -.04em; }
  li { color: var(--dim); transition: color .5s; }
  li[data-on] { color: var(--strong); }
  .note { margin-top: 32px; font-size: 17px; color: var(--muted); }
</style>

<script>
  import "./agents";
</script>
